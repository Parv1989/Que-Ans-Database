# MongoDB connection string (Atlas free tier works fine, or any Mongo host)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bookqabot

# Port the server runs on (most hosts inject this automatically via process.env.PORT)
PORT=5000

# Secret used to sign admin login tokens - change this to a long random string
JWT_SECRET=change_this_to_a_long_random_string

# Admin login credentials (only ONE admin account, simple by design)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Comma separated list of domains allowed to embed the widget (use * for any during testing)
ALLOWED_ORIGINS=*
